// ============================================================
// Detection: Password Spray Attack
// MITRE ATT&CK: T1110.003 - Password Spraying
// Platform: Microsoft Sentinel
// Data Source: Microsoft Entra ID / SigninLogs
// Severity: High
// ============================================================

let TimeWindow = 1h;
let FailedAttemptThreshold = 5;
let TargetedUserThreshold = 3;

SigninLogs
| where TimeGenerated >= ago(TimeWindow)
| where ResultType != 0
| summarize
    FailedAttempts = count(),
    TargetedUsers = dcount(UserPrincipalName),
    TargetedAccounts = make_set(UserPrincipalName, 20)
    by IPAddress
| where FailedAttempts >= FailedAttemptThreshold
| where TargetedUsers >= TargetedUserThreshold
| project
    IPAddress,
    FailedAttempts,
    TargetedUsers,
    TargetedAccounts
| order by FailedAttempts desc
